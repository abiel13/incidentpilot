# Demo mode is deterministic and does not need a paid API or external credentials.
LLM_PROVIDER=demo

# Set LLM_PROVIDER=gemini to use Google's API for evidence synthesis.
# Keep the key on the backend and out of version control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Production only: use a unique username and a long, randomly generated password.
# Store these in your hosting provider's secret settings, not in frontend variables.
POC_USERNAME=
POC_PASSWORD=
# Deployment must mount DATABASE_PATH's parent on durable storage.
REQUIRE_PERSISTENT_VOLUME=false

# The app resolves this path relative to the repository root when it is not absolute.
DATABASE_PATH=data/incidentpilot.sqlite3

# Optional OpenAI-compatible chat-completions endpoint for live diagnosis synthesis.
# Classification, scenario tools, specialist routing and remediation remain deterministic.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional LangSmith tracing. Set LANGSMITH_TRACING=true and supply a key to enable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incidentpilot-demo

FRONTEND_ORIGIN=http://localhost:5173
